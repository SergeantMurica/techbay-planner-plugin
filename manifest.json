{
  "manifest_version": 3,
  "name": "Techbay Work Order Assistant",
  "version": "1.0.0",
  "description": "Fill Techbay work-order fields and add labor products in Shopify Admin.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://admin.shopify.com/*"],
  "optional_host_permissions": ["https://app.workmatepos.co/*"],
  "action": {
    "default_title": "Techbay Work Order Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://admin.shopify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
